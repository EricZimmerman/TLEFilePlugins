<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyTitle>TLEFileGenericCsv</AssemblyTitle>
    <Product>TLEFileGenericCsv</Product>
    <Copyright>Eric R. Zimmerman 2027</Copyright>
    <LangVersion>10</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITLEFileSpec\ITLEFileSpec.csproj" />
  </ItemGroup>
  <ItemGroup>

  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TLEFile.Test" />
  </ItemGroup>
  <ItemGroup>
    <!-- CsvLoader: compiled into each plugin assembly (its reader options) -->
    <Compile Include="..\Shared\CsvLoader.cs" Link="Shared\CsvLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- the source generator of the [CsvRecord] types runs in each project that has them (analyzers are not transitive) -->
    <PackageReference Include="CsvHelper" Version="34.1.0" />
  </ItemGroup>
</Project>
